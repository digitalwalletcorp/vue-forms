{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2022",
    "lib": ["es2022", "dom"],

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",
    /* baseUrl はTS6で非推奨。pathsはtsconfigの位置基準で解決されるため単独で使う */
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./test/*"]
    },
    "resolveJsonModule": true,
    "types": [
      "node"
    ],

    /* Emit */
    "noEmit": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}
