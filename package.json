{
  "name": "@digitalwalletcorp/vue-forms",
  "version": "0.2.0",
  "type": "module",
  "description": "Form components for Vue 3",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./nuxt": {
      "types": "./lib/nuxt.d.ts",
      "import": "./lib/nuxt.js"
    },
    "./register": {
      "import": {
        "types": "./lib/register.d.ts",
        "default": "./lib/register.js"
      },
      "require": {
        "types": "./lib/register.d.cts",
        "default": "./lib/register.cjs"
      }
    },
    "./global": {
      "types": "./lib/global.d.ts"
    },
    "./style.css": "./lib/style.css",
    "./*": {
      "import": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "require": {
        "types": "./lib/*.d.cts",
        "default": "./lib/*.cjs"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "yarn:dedupe": "npx yarn-deduplicate --strategy highest yarn.lock",
    "install:dev": "rm -rf lib dest && find node_modules -mindepth 1 -delete && yarn install",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepack": "rm -rf lib && npm run build",
    "catalog": "vue-tsc --noEmit -p tsconfig.catalog.json && node ../bin/build-form-catalog.mjs docs/catalog/main.ts docs/demo/index.html",
    "pack": "rm -rf dest && mkdir -p dest && npm pack --pack-destination=dest",
    "publish:npm": "bash ../bin/publish.sh",
    "test:unit": "vitest run --coverage"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "components",
    "forms",
    "validation"
  ],
  "author": "satoshi kotaki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalwalletcorp/vue-forms.git"
  },
  "homepage": "https://github.com/digitalwalletcorp/vue-forms",
  "bugs": {
    "url": "https://github.com/digitalwalletcorp/vue-forms/issues"
  },
  "files": [
    "lib/**/*",
    "src/**/*"
  ],
  "peerDependencies": {
    "@digitalwalletcorp/utils": "^0.2.0",
    "@digitalwalletcorp/vue-svg-icons": "^1.15.3",
    "floating-vue": "^5.0.0",
    "vue": "^3.5.29",
    "vue-i18n": "^11.0.0"
  },
  "devDependencies": {
    "@digitalwalletcorp/utils": "^0.2.0",
    "@digitalwalletcorp/vue-svg-icons": "^1.15.3",
    "@nuxt/kit": "^3.17.5",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "floating-vue": "^5.2.2",
    "happy-dom": "20.14.5",
    "nuxt": "^3.17.5",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "5.1.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.4",
    "vue": "^3.5.29",
    "vue-i18n": "^11.4.12",
    "vue-tsc": "3.1.5"
  }
}
